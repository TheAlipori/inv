---
import "@fontsource/josefin-sans";
import "@fontsource/great-vibes";

const { colorPrimario } = Astro.props;
---

<section class="h-full flex flex-col items-center justify-center px-6">
  <div
    class="flex flex-col items-center gap-5 text-center px-8 py-10 rounded-3xl w-full max-w-sm"
    style="background: rgba(255,255,255,0.12); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,0.25);"
  >
    <p
      class="text-sm tracking-widest uppercase"
      style={`font-family: 'Josefin Sans', sans-serif; color: ${colorPrimario}; opacity: 0.7;`}
      data-aos="fade-down"
      data-aos-duration="800"
    >
      Habrá piscina
    </p>

    <!-- Ícono de alberca -->
    <div data-aos="zoom-in" data-aos-duration="1000" data-aos-delay="100">
      <svg
        class="w-20 h-20 opacity-90"
        style={`color: ${colorPrimario};`}
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
      >
        <path fill="currentColor" d="M2 18c2.22-1 4.44-2 6.67-2c2.22 0 4.44 2 6.66 2c2.23 0 4.45-2 6.67-2v3c-2.22 0-4.44 2-6.67 2c-2.22 0-4.44-2-6.66-2c-2.23 0-4.45 1-6.67 2zm6.67-5c-.78 0-1.55.12-2.32.32l4.92-3.44l-1.04-1.24c-.14-.17-.23-.4-.23-.64c0-.34.17-.65.44-.83l5.72-4l1.15 1.63l-4.84 3.39l5.23 6.23c-.79.33-1.58.58-2.37.58c-2.22 0-4.44-2-6.66-2M18 7a2 2 0 0 1 2 2a2 2 0 0 1-2 2a2 2 0 0 1-2-2a2 2 0 0 1 2-2"/>
      </svg>
    </div>

    <h2
      class="text-5xl leading-snug"
      style={`font-family: 'Great Vibes', cursive; color: ${colorPrimario};`}
      data-aos="fade-up"
      data-aos-duration="1000"
      data-aos-delay="200"
    >
      ¡Trae tu traje de baño!
    </h2>

    <p
      class="text-sm leading-relaxed max-w-xs"
      style={`font-family: 'Josefin Sans', sans-serif; color: ${colorPrimario}; opacity: 0.85;`}
      data-aos="fade-up"
      data-aos-duration="1000"
      data-aos-delay="300"
    >
      Contaremos con alberca, así que si deseas darte un chapuzón eres más que bienvenido.
    </p>
  </div>
</section>
