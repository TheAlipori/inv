---
import "@fontsource/josefin-sans";
import "@fontsource/great-vibes";
import SalonIcon from "../../../assets/icons/SalonIcon.astro";
import Ornamento1 from "../../../assets/icons/Ornamento1.astro";

const { recepcion, colorPrimario } = Astro.props;
---

<section class="h-full flex flex-col items-center justify-center px-8 gap-6 text-center">

  <!-- Título -->
  <p
    class="text-sm tracking-widest uppercase"
    style={`font-family: 'Josefin Sans', sans-serif; color: ${colorPrimario}; opacity: 0.7;`}
    data-aos="fade-down"
    data-aos-duration="800"
  >
    Nos vemos en
  </p>

  <!-- Icono -->
  <div data-aos="zoom-in" data-aos-duration="1000" data-aos-delay="100">
    <SalonIcon style={`fill: ${colorPrimario};`} class="w-16 h-16 opacity-90" />
  </div>

  <!-- Nombre del lugar -->
  <h2
    class="text-4xl"
    style={`font-family: 'Great Vibes', cursive; color: ${colorPrimario};`}
    data-aos="fade-up"
    data-aos-duration="1000"
    data-aos-delay="200"
  >
    {recepcion.lugar}
  </h2>

  <!-- Ornamento -->
  <div data-aos="fade-up" data-aos-duration="800" data-aos-delay="300">
    <Ornamento1 style={`fill: ${colorPrimario};`} class="w-28 opacity-60" />
  </div>

  <!-- Dirección -->
  <p
    class="text-sm leading-relaxed max-w-xs"
    style={`font-family: 'Josefin Sans', sans-serif; color: ${colorPrimario}; opacity: 0.8;`}
    data-aos="fade-up"
    data-aos-duration="800"
    data-aos-delay="400"
  >
    {recepcion.direccion}
  </p>

  <!-- Hora -->
  <p
    class="text-2xl"
    style={`font-family: 'Great Vibes', cursive; color: ${colorPrimario};`}
    data-aos="fade-up"
    data-aos-duration="800"
    data-aos-delay="500"
  >
    {recepcion.hora}
  </p>

  <!-- Botón Maps -->
  {recepcion.maps && (
    <a
      href={recepcion.maps}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 px-6 py-2 rounded-full text-white text-sm tracking-widest uppercase transition-all duration-300 hover:scale-105 active:scale-95"
      style={`background-color: ${colorPrimario}; font-family: 'Josefin Sans', sans-serif;`}
      data-aos="fade-up"
      data-aos-duration="800"
      data-aos-delay="600"
    >
      Cómo llegar
    </a>
  )}

</section>
