---
import "@fontsource/josefin-sans";
import "@fontsource/great-vibes";
import Ornamento1 from "../../../assets/icons/Ornamento1.astro";

const { quinceanera, whatsapp, colorPrimario } = Astro.props;

const mensaje = encodeURIComponent(`¡Hola! Confirmo mi asistencia a los XV de ${quinceanera.nombre} 🌿`);
const waUrl = `https://wa.me/${whatsapp}?text=${mensaje}`;
---

<section class="h-full flex flex-col items-center justify-center px-8 gap-6 text-center">

  <!-- Título -->
  <p
    class="text-sm tracking-widest uppercase"
    style={`font-family: 'Josefin Sans', sans-serif; color: ${colorPrimario}; opacity: 0.7;`}
    data-aos="fade-down"
    data-aos-duration="800"
  >
    Confirmación de asistencia
  </p>

  <!-- Ornamento -->
  <div data-aos="zoom-in" data-aos-duration="800" data-aos-delay="100">
    <Ornamento1 style={`fill: ${colorPrimario};`} class="w-32 opacity-70" />
  </div>

  <!-- Mensaje -->
  <h2
    class="text-4xl leading-snug"
    style={`font-family: 'Great Vibes', cursive; color: ${colorPrimario};`}
    data-aos="fade-up"
    data-aos-duration="1000"
    data-aos-delay="200"
  >
    ¿Nos acompañarás?
  </h2>

  <p
    class="text-sm max-w-xs leading-relaxed"
    style={`font-family: 'Josefin Sans', sans-serif; color: ${colorPrimario}; opacity: 0.8;`}
    data-aos="fade-up"
    data-aos-duration="800"
    data-aos-delay="300"
  >
    Por favor confirma tu asistencia antes del <strong>20 de Mayo</strong>.
  </p>

  <!-- Botón WhatsApp -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-3 px-8 py-3 rounded-full text-white text-sm tracking-widest uppercase transition-all duration-300 hover:scale-105 active:scale-95 shadow-lg"
    style={`background-color: ${colorPrimario}; font-family: 'Josefin Sans', sans-serif;`}
    data-aos="fade-up"
    data-aos-duration="800"
    data-aos-delay="400"
  >
    <!-- WhatsApp icon -->
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    Confirmar asistencia
  </a>

</section>
